# VisiumGo Test Analyzer — ortam yapılandırması
# `.env` olarak kopyalayın ve boşları doldurun. `.env` depoya girmez, bu dosya girer.
# Çevrimdışı mod yoktur: erişilebilir bir VisiumGo ve model olmadan uygulama iş yapmaz.

# --- VisiumGo bağlantısı (ZORUNLU: bu ikisi doldurulmadan analiz yapılamaz) ---
VISIUMGO_BASE_URL=
VISIUMGO_TOKEN=
VISIUMGO_TIMEOUT_SECONDS=60
# Kurum içi sertifika doğrulaması kapalı. Açmak için true.
VISIUMGO_VERIFY_SSL=false
# Build log: VisiumGo'nun /logs ucu DÜZ METİN değil ZIP döndürür; log bellekte
# açılır, diske yazılmaz. Çağrılıp çağrılmayacağına PROFİL karar verir (listesinde
# BuildLogEvidence varsa çağrılır). Hata olursa sebebi `build_log_error` alanına
# yazılır ve analiz devam eder.
# ZIP içinde okunacak girdi (sonuna göre eşleşir; `Run_Logs_123/build.log` de tutar).
VISIUMGO_BUILD_LOG_ENTRY=build.log

# --- Model (kurum içi) ---
# İstek adresi = LLM_BASE_URL + LLM_ENDPOINT_PATH
LLM_BASE_URL=https://test-automation-ai-api.apps.nonfin-vip.zke.zb
LLM_ENDPOINT_PATH=/api/v1/extension/send
# Bu serviste kimlik doğrulama yok; boş bırakın. Doluysa "Bearer <key>" gönderilir.
LLM_API_KEY=
# Yalnızca kayda yazılır — istek gövdesinde GÖNDERİLMEZ.
LLM_MODEL=qwen3-coder-next
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
LLM_VERIFY_SSL=false

# --- Kayıt: koşumlar ve teşhisler ---
# file   = JSON olarak DATABASE_DIR altına yazılır ve oradan okunur (varsayılan).
#          Hiçbir koşum silinmez; uygulama yeniden başlasa da eski koşumlar
#          GET ile alınabilir.
# memory = hiçbir şey diske yazılmaz; satırlar bellekte durur, MAX_KEPT_RUNS
#          dolunca en eski koşum teşhisleriyle birlikte düşer.
REPOSITORY_PROVIDER=file
# Yerleşim: <DATABASE_DIR>/runs/<analyzer_run_id>.json ve
#           <DATABASE_DIR>/analysis_results/<analyzer_run_id>/<result_id>.json
# Koşum başına klasör, çünkü hiçbir şey silinmiyor: bir koşumun cevabı yalnız
# kendi klasörünü okur, bugüne kadarki bütün teşhisleri değil.
DATABASE_DIR=database
# YALNIZCA memory modunda okunur. file modunda hiçbir koşum silinmez.
MAX_KEPT_RUNS=20
TABLE_RUNS=runs
TABLE_ANALYSIS_RESULTS=analysis_results

# --- Kayıt: modele ne gitti, ne geldi (iz) ---
# Analiz edilen her senaryo için İKİ dosya yazılır:
#   <TRACE_DIR>/<analyzer_run_id>/<senaryo>.prompt.txt    -> modele giden metnin birebir kendisi
#   <TRACE_DIR>/<analyzer_run_id>/<senaryo>.response.json -> modelden dönen ham cevap + süre/token
# Başka hiçbir şey (ek dosyalar, build.log) diske yazılmaz. Gruplanan senaryoların
# ve katalogdan cevaplananların prompt'u olmadığı için dosyası da olmaz.
# BOŞ bırakılırsa hiçbir şey yazılmaz, klasör bile oluşmaz.
TRACE_DIR=iz

# --- Analiz profilleri ---
# Profili İSTEĞİ ATAN seçer: POST gövdesindeki `profil` alanı bu dosyadaki bir ada
# eşit olmalı: web · mobil · finart · error.
# `error` elle de seçilebilir; ayrıca koşumun KENDİSİ çöktüğünde
# (runResult.state=FAILED) sistem, profil ne istenirse istensin onu uygular.
# `error` KOŞUM SEVİYESİ bir profildir (`run_level: true`): senaryo satırları hiç
# okunmaz, koşumun kendisi için TEK bir teşhis üretilir, kanıt yalnız build.log'dur.
# Profil, hangi kanıtın modele gideceğini ve nasıl kırpılacağını söyler.
# Yeni davranış = config satırı, kod değişmez.
PROFILES_CONFIG_PATH=config/profiles.json

# --- Bilinen hatalar (modele hiç gitmeden cevap) ---
# known_errors = adım + hata mesajı KATALOGDAKİYLE birebir eşleşirse modele hiç
#                gitmeden dosyadaki cevabı dön (varsayılan). Katalog boşken hiçbir
#                senaryo eşleşmez, yani her senaryo modele gider.
# noop         = kontrolü tamamen kapat.
PRECHECK_PROVIDER=known_errors
# Her satır: adım + hata mesajı + cevap + verdict + confidence. Eşleşme BİREBİR.
# Adımı ya da hata mesajı boş olan senaryo hiç eşleşmez.
KNOWN_ERRORS_PATH=config/known_errors.json

# --- Prompt ---
# Her profil kendi şablonunu seçer (config/prompts/<ad>.txt); hepsi ortak
# `_contract.txt` ile biter (JSON şeması, verdict değerleri, confidence basamakları).
PROMPTS_DIR=config/prompts
CONFIDENCE_BUCKETS=[0.1,0.25,0.5,0.75,0.99]

# --- Eşzamanlılık ---
# Aynı anda kaç senaryonun işleneceği (dosya okuma + prompt + model çağrısı).
# Sınır SÜREÇ başınadır. Uygulama TEK SÜREÇ çalıştırılmalı: `--workers 2` ile iki
# süreç de açılışta aynı yarım koşumu devam ettirir ve model iki kez çağrılır.
MAX_CONCURRENCY=2

# --- Kaynak (tek sağlayıcı) ---
SOURCE_PROVIDER=visiumgo
LLM_PROVIDER=openai_compatible
