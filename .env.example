# VisiumGo Test Analyzer — environment configuration
# Copy to `.env` and fill the blanks. `.env` is NOT committed; this file is.
# Defaults below are REAL mode: VisiumGo + real LLM, SSL off. There is no offline
# mode — without a reachable VisiumGo and model the app does not start.

# --- persistence (registry key) ---
# file   = koşum ve teşhis satırları DATABASE_DIR altına JSON olarak yazılır ve
#          oradan okunur (varsayılan). Hiçbir koşum silinmez; uygulama yeniden
#          başlasa da eski koşumlar GET ile alınabilir.
# memory = hiçbir şey diske yazılmaz; satırlar bellekte durur, MAX_KEPT_RUNS
#          dolunca en eski koşum teşhisleriyle birlikte düşer.
REPOSITORY_PROVIDER=file
# Yerleşim: <DATABASE_DIR>/runs/<analyzer_run_id>.json ve
#           <DATABASE_DIR>/analysis_results/<analyzer_run_id>/<result_id>.json
# Koşum başına klasör, çünkü hiçbir şey silinmiyor: bir koşumun cevabı yalnız
# kendi klasörünü okur, bugüne kadarki bütün teşhisleri değil.
DATABASE_DIR=database
# file modunda, süreç bir koşum analiz edilirken ölürse: uygulama açılışta o
# koşumu bulur ve KALDIĞI YERDEN devam eder — tamamlanmış teşhisler korunur,
# model onlar için yeniden çağrılmaz. Devam ettirildiği hâlde tek bir senaryo
# bile tamamlanmazsa koşum "failed" olarak kapatılır (çökme döngüsü olmasın).
# memory modunda devam ettirilecek bir şey yoktur: satırlar zaten gitmiştir.
#
# YALNIZCA memory modunda okunur. file modunda hiçbir koşum silinmez.
MAX_KEPT_RUNS=20
TABLE_RUNS=runs
TABLE_ANALYSIS_RESULTS=analysis_results

# --- iz (trace) ---
# BOŞ = hiçbir şey yazılmaz, klasör bile oluşmaz. VARSAYILAN.
# Bir yol verirsen, analiz edilen her senaryo için SADECE iki dosya yazılır:
#   <TRACE_DIR>/<analyzer_run_id>/<senaryo>.prompt.txt   -> modele giden metin
#   <TRACE_DIR>/<analyzer_run_id>/<senaryo>.response.json -> modelden dönen cevap
# Başka hiçbir şey (ek dosyalar, build.log, kanıt raporu) diske yazılmaz.
# Gruplanan senaryoların ve bilinen hatalardan cevaplananların prompt'u yoktur,
# dolayısıyla dosyası da olmaz.
TRACE_DIR=

# --- source / Halka 1 (registry key) ---
# Tek kaynak var: gerçek VisiumGo. Sahte kaynak yok — üretilmiş veri gerçek
# veriye benzediği için, "bu satır gerçek mi" sorusu hiç doğmasın diye.
SOURCE_PROVIDER=visiumgo

# --- VisiumGo connection (required when SOURCE_PROVIDER=visiumgo) ---
# FILL these two on the work PC (base URL + JWT token). Never committed.
VISIUMGO_BASE_URL=
VISIUMGO_TOKEN=
VISIUMGO_TIMEOUT_SECONDS=60
# SSL verification off (internal self-signed certs). true to enable.
VISIUMGO_VERIFY_SSL=false
# --- Build log (VisiumGo'nun /logs endpoint'i) ---
# Endpoint'in YOLU burada DEĞİL: o bir ayar değil, VisiumGo'nun sözleşmesi
# (app/source/visiumgo.py). Çağrılıp çağrılmayacağına PROFİL karar verir:
# profilin listesinde `BuildLogEvidence` varsa çağrılır, yoksa hiç çağrılmaz.
# Endpoint DÜZ METİN değil ZIP döndürür; log bellekte açılır, diske yazılmaz.
# Hata olursa sebebi `build_log_error` alanına yazılır ve analiz devam eder.
# ZIP içinde okunacak dosya (sonuna göre eşleşir; `logs/build.log` de tutar).
VISIUMGO_BUILD_LOG_ENTRY=build.log

# --- extraction / Halka 2 ---
# Analiz profilleri. Profili İSTEĞİ ATAN seçer: POST gövdesindeki `profil` alanı bu
# dosyadaki bir ada eşit olmalı (web · mobil · finart). `job_failed` elle
# seçilemez — koşumun KENDİSİ çöktüğünde (runResult.state=FAILED) sistem onu uygular.
# Profil, hangi kanıtın LLM'e/depoya gideceğini ve hangi kırpma kurallarının
# uygulanacağını söyler. Yeni davranış = config satırı, kod değişmez.
PROFILES_CONFIG_PATH=config/profiles.json

# --- precheck (registry key) ---
# known_errors  = adım + hata mesajı KATALOGDAKİYLE birebir eşleşirse LLM'e hiç
#                 gitmeden dosyadaki cevabı dön (varsayılan). Katalog boşken
#                 hiçbir senaryo eşleşmez, yani her senaryo LLM'e gider.
# noop          = kontrolü tamamen kapat; her senaryo LLM'e gider.
PRECHECK_PROVIDER=known_errors
# Bilinen hatalar kataloğu: her satır adım + hata mesajı + cevap + verdict +
# confidence taşır. Eşleşme BİREBİR: adım ve hata, senaryonunkilerle tam aynı
# olmalı. Adımı ya da hata mesajı boş olan senaryo hiç eşleşmez.
KNOWN_ERRORS_PATH=config/known_errors.json

# --- prompt / Halka 3 ---
# Şablon klasörü: her job grubu kendi şablonunu profilden seçer
# (config/prompts/<ad>.txt) ve hepsi ortak `_contract.txt` ile biter.
PROMPTS_DIR=config/prompts
CONFIDENCE_BUCKETS=[0.1,0.25,0.5,0.75,0.99]

# --- LLM / Halka 4 (registry key) ---
# Tek sağlayıcı var: kurum içi model. Sahte cevap üreten sağlayıcı yok.
LLM_PROVIDER=openai_compatible
# Full request URL = LLM_BASE_URL + LLM_ENDPOINT_PATH.
LLM_BASE_URL=https://test-automation-ai-api.apps.nonfin-vip.zke.zb
LLM_ENDPOINT_PATH=/api/v1/extension/send
# No auth for this service; leave empty. Sent as "Bearer <key>" only if set.
LLM_API_KEY=
# Recorded in meta only — NOT sent in the request body.
LLM_MODEL=qwen3-coder-next
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# SSL verification off (internal self-signed certs). true to enable.
LLM_VERIFY_SSL=false

# --- API / background processing ---
# Aynı anda kaç senaryonun işleneceği (dosya okuma + prompt + model çağrısı).
# Bu sınır SÜREÇ başınadır. Uygulama TEK SÜREÇ çalıştırılmalı: `uvicorn --workers 2`
# ile iki süreç de açılışta aynı yarım koşumu devam ettirir ve model iki kez çağrılır.
MAX_CONCURRENCY=2
