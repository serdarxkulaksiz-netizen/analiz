# VisiumGo Test Analyzer — environment configuration
# Copy to `.env` and fill the blanks. `.env` is NOT committed; this file is.
# Defaults below are REAL mode: VisiumGo + real LLM, SSL off, cache off.
# (For an offline demo without any real service, set both providers to `mock`.)

# --- persistence / DB simulation (plan.md A12) ---
DATABASE_DIR=database
TABLE_RUNS=runs
TABLE_ANALYSIS_RESULTS=analysis_results
TABLE_EVIDENCE=evidence
TABLE_PROMPTS=prompts
TABLE_LLM_RESPONSES=llm_responses

# --- source / Halka 1 (registry key) ---
# visiumgo | mock
SOURCE_PROVIDER=visiumgo

# --- VisiumGo connection (required when SOURCE_PROVIDER=visiumgo) ---
# FILL these two on the work PC (base URL + JWT token). Never committed.
VISIUMGO_BASE_URL=
VISIUMGO_TOKEN=
VISIUMGO_TIMEOUT_SECONDS=60
# SSL verification off (internal self-signed certs). true to enable.
VISIUMGO_VERIFY_SSL=false
# --- Jenkins console.log (VisiumGo'nun kendi endpoint'i) ---
# ↓↓↓ BURAYA YAZ: servis hazır olunca endpoint YOLUNU buraya yapıştır ↓↓↓
#
#   * Sadece YOL yaz, tam URL değil — başına VISIUMGO_BASE_URL eklenir.
#   * `{run_id}` yer tutucusu koşum id'siyle değiştirilir (URL-encode edilir).
#   * Servis DÜZ METİN (text/plain) log döndürmeli.
#   * BOŞ bırakılırsa adım tamamen atlanır (bugünkü durum).
#   * Servis hata verirse log boş kalır, analiz normal devam eder.
#
#   Örnek:  VISIUMGO_JENKINS_LOG_PATH=/api/runs/{run_id}/jenkins-log
#
VISIUMGO_JENKINS_LOG_PATH=

# --- extraction / Halka 2 (plan.md A5) ---
# Analiz profilleri: job_id (veya parameter1) -> hangi kanıt LLM'e/depoya gider
# ve her kanıta hangi kırpma kuralları uygulanır. Yeni job = config satırı.
PROFILES_CONFIG_PATH=config/profiles.json

# --- precheck (registry key, plan.md A7) ---
# noop  = her senaryo LLM'e gider (varsayılan)
# rules = bilinen hatalara LLM'e HİÇ gitmeden hazır cevap dön (aşağıdaki dosya)
PRECHECK_PROVIDER=noop
# Kural listesi. Boş liste ile gelir; doldurmadan `rules` moduna almanın etkisi yok.
# UYARI: kural LLM'i tamamen atlar — kalıpları DAR yazın (ör. "ORA-01017"),
# "error"/"failed" gibi genel kelimeler her senaryoyu yanlış etiketler.
PRECHECK_RULES_PATH=config/precheck_rules.json

# --- prompt / Halka 3 (plan.md A8) ---
PROMPT_TEMPLATE_PATH=config/prompt_template.txt
CONFIDENCE_BUCKETS=[0.1,0.25,0.5,0.75,0.99]

# --- LLM / Halka 4 (registry key) ---
# openai_compatible | mock
LLM_PROVIDER=openai_compatible
# Full request URL = LLM_BASE_URL + LLM_ENDPOINT_PATH.
LLM_BASE_URL=https://test-automation-ai-api.apps.nonfin-vip.zke.zb
LLM_ENDPOINT_PATH=/api/v1/extension/send
# No auth for this service; leave empty. Sent as "Bearer <key>" only if set.
LLM_API_KEY=
# Recorded in meta only — NOT sent in the request body.
LLM_MODEL=qwen3-coder-next
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# SSL verification off (internal self-signed certs). true to enable.
LLM_VERIFY_SSL=false

# --- API / background processing (plan.md A13) ---
MAX_CONCURRENCY=2
# Run cache off: the same job is always re-analyzed (no reuse of prior runs).
# true: aynı run_id + parametreler daha önce analiz edildiyse LLM'e gidilmez,
# sonuçlar diskten döner. Koşum bazlıdır — bir job'ın her koşumu ayrı analiz edilir.
CACHE_ENABLED=false
